# Rust
/target
**/*.rs.bk
# NB: Cargo.lock IS committed — this workspace ships a binary (aqua-server).

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Env / secrets
.env
.env.*
!.env.example

# Local state / test data
/data
/.aqua-dev

# Frontend build output / deps
**/node_modules/
crates/aqua-client-ui/ui/dist/
crates/aqua-client-ui/gen/

# Runtime data written next to the binaries
*.sqlite
*.sqlite-*
aqua-admin.json
# SMTP login + app password (admin panel)
aqua-smtp.json
# Federation secret and this relay's private node key (REV2-001: a test run
# once wrote the key here and it was committed — never again)
aqua-federation.json
aqua-fed-node.key
aqua-fed-seen.log
aqua-fed-seen.tmp
*.key
# Who came online / signed in (admin panel journal)
aqua-journal.log
# Everything else the relay writes into its data folder (a run from a
# checkout puts it here). Secrets among them: the TURN secret, the Telegram
# bot token, the Boosty login cookie, the Navidrome login (review 27.11:
# aqua-turn.secret was left untracked, not ignored).
aqua-*.secret
aqua-*.log
aqua-*.lock
aqua-*.clean
aqua-*.tmp
aqua-telegram.json
aqua-telegram-net.json
aqua-tg-webhooks.json
aqua-boosty-auth.json
aqua-boosty-links.json
aqua-navidrome.json
aqua-updates.json
aqua-quota-over.json
aqua-pack-rules.json
aqua-games.json
aqua-bot-specs.json
aqua-blobs/
aqua-update/
aqua-packs/
panel.json
proxy.txt
/.data-*
/Aquamarine-apps/

# Built installers dropped into the site
site/downloads/*.exe
site/downloads/*.msi
site/downloads/*.dmg
site/downloads/*.AppImage
site/downloads/*.deb
site/downloads/*.rpm

# Nested cargo targets (the Tauri crate has its own)
**/target/

# Per-PC NDK linker paths written by android/patch-project.ps1
crates/aqua-client-ui/.cargo/
__pycache__/

# Documents copied in by pages.yml
site/docs/
docker/bin/

# The star signing key (aqua-server star-key) never goes into the repository.
aqua-star.key
aqua-stars.json
